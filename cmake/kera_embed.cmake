# Turns files into a C++ source the kera binary is built with (see app/kera_web_assets.h).
# Run as a script:
#   cmake -DOUT=<file.cpp> -DPAIRS="<source path>=<asset name>|..." -P kera_embed.cmake

if (NOT OUT OR NOT PAIRS)
    message(FATAL_ERROR "kera_embed.cmake needs OUT and PAIRS")
endif()
string(REPLACE "|" ";" PAIRS "${PAIRS}")

set(body "// Generated by cmake/kera_embed.cmake. Do not edit.\n#include \"kera_web_assets.h\"\n\n")
set(table "")
set(i 0)
foreach(pair IN LISTS PAIRS)
    string(FIND "${pair}" "=" eq REVERSE)
    string(SUBSTRING "${pair}" 0 ${eq} src)
    math(EXPR name_start "${eq} + 1")
    string(SUBSTRING "${pair}" ${name_start} -1 name)

    file(READ "${src}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # wrap long lines so compilers (MSVC in particular) and editors stay happy; CMake regexes have no {n}
    string(REPEAT "0x[0-9a-f][0-9a-f]," 24 row)
    string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")

    string(APPEND body "static const unsigned char kera_asset_${i}[] = {\n${bytes}\n0x00 };\n\n")
    string(APPEND table "    { \"${name}\", kera_asset_${i}, ${size} },\n")
    math(EXPR i "${i} + 1")
endforeach()

string(APPEND body "const kera_web_asset kera_web_assets[] = {\n${table}};\n")
string(APPEND body "const size_t kera_web_assets_count = ${i};\n")

# only touch the file when the contents change, so the binary isn't rebuilt for nothing
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if ("${old}" STREQUAL "${body}")
        return()
    endif()
endif()
file(WRITE "${OUT}" "${body}")
