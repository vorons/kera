# Model weights and caches never go in git (ground rule 8, P8 item 7).
# Tiny test models are generated by a script during the tests.
*.gguf
*.safetensors
*.bin
# Anchored to the repo root on purpose: src/cache/ and src/kvstore/ are source folders.
/models/
/cache/
/kvstore/

# Build output
/build*/
/out/
CMakeUserPresets.json
compile_commands.json
.cache/

# Bench output stays local unless a run is chosen for the record
/bench/results/*.local.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node (app web page tooling)
node_modules/

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
/tools/compare/mac-app/build/

# agent worktrees (local only)
.claude/worktrees/
